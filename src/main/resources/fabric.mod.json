{
  "schemaVersion": 1,
  "id": "autotpa",
  "version": "${version}",
  "name": "AutoTPA",
  "description": "Client-side TPA request manager: auto-accept trusted players, block unwanted requests, and hide related sounds. No telemetry, no server-side changes.",
  "authors": [
    "Fr4ncyILGrande"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "de.fr4ncyilgrande.autotpa.client.AutoTpaClient"
    ]
  },
  "mixins": [
    {
      "config": "autotpa.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": "~26.2",
    "java": ">=25"
  }
}
